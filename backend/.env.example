# Copie este arquivo para ".env" e ajuste os valores.

# Ambiente: development | test | production
NODE_ENV=development
PORTA=3000

# Conexão com o PostgreSQL (o docker-compose da raiz sobe um banco com estes dados).
# O banco precisa da extensão pgvector: use o do docker-compose (imagem pgvector/pgvector).
DATABASE_URL=postgres://fersa:fersa@localhost:5432/fersa_care
# Banco do "npm test", apagado e recriado a cada execução (padrão: fersa_care_teste na 5432).
# DATABASE_URL_TESTE=postgres://fersa:fersa@localhost:5432/fersa_care_teste

# Segredo usado para assinar os tokens de login (JWT). Obrigatório em produção.
# Gere um valor aleatório com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SEGREDO=troque-este-valor-por-um-segredo-com-mais-de-32-caracteres
# Por quantas horas o login continua válido
JWT_EXPIRACAO_HORAS=8

# true quando o site roda em HTTPS (o cookie de sessão só trafega por HTTPS)
COOKIE_SEGURO=false

# Onde os arquivos enviados pelo administrador ficam guardados
UPLOAD_DIR=./uploads
# Tamanho máximo de cada arquivo (MB) — vídeos costumam ser os maiores
UPLOAD_LIMITE_MB=200

# Pasta com o build do front-end (frontend/dist). Quando definida, a API também
# entrega o site, tudo na mesma porta (é assim que o Docker roda).
# FRONTEND_DIST=../frontend/dist

# Quantos proxies reversos (nginx, load balancer) ficam na frente da API. 0 = nenhum.
CONFIAR_PROXY=0

# Administrador criado pelo "npm run db:seed" quando ainda não existe nenhum
ADMIN_NOME=Administrador FERSA CARE
ADMIN_EMAIL=admin@fersacare.com.br
ADMIN_SENHA=Admin@123
