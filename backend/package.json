{
  "name": "fersa-care-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST do portal de pós-venda FERSA CARE (Node.js + TypeScript + PostgreSQL)",
  "author": "Alexandre Breus da Cunha (https://github.com/LxzCunha)",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LxzCunha/Fersa-Care.git",
    "directory": "backend"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:corrigir": "eslint . --fix",
    "db:gerar": "drizzle-kit generate",
    "db:migrar": "tsx src/db/migrar.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:exemplos": "tsx src/db/seed.ts --exemplos",
    "db:studio": "drizzle-kit studio",
    "capas:gerar": "tsx src/db/gerar-capas.ts",
    "ia:indexar": "tsx src/db/indexar-documentos.ts",
    "setup": "npm run db:migrar && npm run db:seed:exemplos",
    "test": "vitest run",
    "test:unidade": "vitest run --project unidade",
    "test:integracao": "vitest run --project integracao",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "bcryptjs": "^3.0.3",
    "content-disposition": "^3.0.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
