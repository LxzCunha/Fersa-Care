{
  // Configuração usada pelo editor e pelo "npm run typecheck" (inclui os testes).
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    // lista[0] e registro[chave] podem ser undefined: o tipo passa a dizer isso.
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src", "tests", "drizzle.config.ts", "vitest.config.ts"]
}
